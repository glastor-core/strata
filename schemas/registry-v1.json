{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlastorUiRegistryManifest",
  "description": "Schema for glastor-ui-engine component registry manifest (registry.json)",
  "type": "object",
  "required": ["version", "name", "description", "components"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry schema version"
    },
    "name": {
      "type": "string",
      "description": "Unique identifier for this registry"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description", "frameworks", "files"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "frameworks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string" },
                "version": { "type": "string" },
                "features": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "content"],
              "properties": {
                "path": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
